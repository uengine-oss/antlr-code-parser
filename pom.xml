<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<!-- 취약점 보정 ③ (2026-10-16) — 3.3.0 → 3.5.16.
		     Boot 의 BOM 이 tomcat·spring·jackson 버전을 정하므로, 이 한 줄이
		     그 셋을 함께 올린다. 2026-10-16 실측으로 **치명·고위험 41건 중 32건**
		     이 걷힌다(done13 §267 · `2026-10-16/자바-올림-예측.py`).
		       tomcat  10.1.24 → 10.1.55   (24건이 여기 있었다)
		       spring  6.1.8   → 6.2.19
		       jackson 2.17.1  → 2.21.4
		     4.1.1 은 3건을 더 걷지만 **Spring 7 · Jackson 3** 메이저 둘을 건너야
		     한다 — 얻는 것에 비해 회귀 범위가 크다. 3.x 안에 머문다. -->
		<version>3.5.16</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>legacymodernizer</groupId>
	<artifactId>parser</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>parser</name>
	<description>Demo project for Spring Boot</description>
	<properties>
	    <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
		<java.version>17</java.version>
		<antlr4.version>4.13.2</antlr4.version>
		<!-- 취약점 보정 ⑧ (2026-10-19) — Boot 3.5.16 의 BOM 을 **덮어쓴다**.
		     굽고 재니 3.5.16 이 정한 판에 아직 남은 것이 있었다(done14 §288):
		       tomcat-embed-core 10.1.55 → **10.1.61**  치명 3건
		         (CVE-2026-65905 인증 우회 9.8 · 68525 9.1 · 65182 9.1)
		     ⚠ 권고문이 적은 "고쳐진 판" 은 **10.1.58 인데 그 번호는 발행되지
		       않았다** — Central 에 10.1.57 다음이 10.1.59 다. 빌드가
		       "Could not find artifact … 10.1.58" 로 멈춰서 알았다.
		       권고 범위가 `<10.1.58` 이므로 **그 이상이면 된다** → 10.1.x 의
		       마지막인 **10.1.61**. **권고문의 숫자를 그대로 쓰지 않는다 —
		       있는 판인지 먼저 본다.**
		       jackson 2.21.4            → **2.21.7**   고위험 5건
		         (databind 3 · core 2 — 2.21.6 까지가 영향 범위다)
		     api-gateway 가 10-19 에 같은 바닥(`jackson-bom` 2.21.7)을 깔았다.
		     ⚠ `spring-webmvc` 6.2.19 의 치명 2건은 **고칠 판이 없다**
		     (CVE-2026-47890 · 47884 모두 "not fixed") — Boot 를 올려도 안 걷힌다.
		     ⚠ Go `stdlib` 치명 2 · 고위험 9 는 **베이스 이미지**다(ISS-39). -->
		<tomcat.version>10.1.61</tomcat.version>
		<jackson-bom.version>2.21.7</jackson-bom.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>${antlr4.version}</version>
        </dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
				<configuration>
					<systemPropertyVariables>
						<parser.data.root>${project.build.directory}/test-data</parser.data.root>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		    <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <version>${antlr4.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                        <configuration>
                            <sourceDirectory>src/main/antlr4</sourceDirectory>
                            <outputDirectory>${project.build.directory}/generated-sources/antlr4</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<mainClass>legacymodernizer.parser.ParserApplication</mainClass>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.1</version>
				<configuration>
					<source>${maven.compiler.source}</source>
					<target>${maven.compiler.target}</target>
					<generatedSourcesDirectory>target/generated-sources/antlr4</generatedSourcesDirectory>
				</configuration>
       		</plugin>
		</plugins>
	</build>

</project>
